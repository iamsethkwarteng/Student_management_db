Table Departments {
 department_id int [pk, increment]
 name varchar(100) [not null, unique]
 location varchar(100)
 created_at timestamp [default: `now()`]
}

Table Students {
  student_id int [pk, increment]
  first_name varchar(50) [not null]
  last_name varchar(50) [not null]
  date_of_birth date 
  email varchar(100) [not null, unique]
  phone varchar(20)
  enrolled_date date [default: `now()`]
  department_id int [not null, ref: > Departments.department_id]
  is_active boolean [default: true]
  created_at timestamp [default: `now()`]
}

Table Instructors {
  instructor_id int [pk, increment]
  first_name varchar(50) [not null]
  last_name varchar(50) [not null]
  email varchar(100) [not null, unique]
  phone varchar(20)
  date_of_birth date 
  hire_date date [default: `now()`]
  end_date date [check: `end_date is null or end_date >= hire_date`]
  salary numeric(10,2)
  department_id int [not null,ref: > Departments.department_id]
  created_at timestamp [default: `now()`]
}

Table Courses {
  course_id int [pk, increment]
  course_name varchar(100) [not null, unique]
  course_code varchar(20) [not null, unique]
  description text
  credits int 
  created_date timestamp [default: `now()`]
  department_id int [not null,ref: > Departments.department_id]
}

Table Classes{
 class_id int [pk, increment]
 course_id int [not null, ref: > Courses.course_id ]
 instructor_id int [not null, ref:> Instructors.instructor_id]
 semester varchar(20) [not null]
 year int [not null]
 max_students int [not null, default: 30, check: `max_students > 0`]
 schedule varchar(100)
 created_at timestamp [default: `now()`]
}

Table Enrollments {
  enrollment_id int [pk, increment]
  student_id int [not null, ref: > Students.student_id]
  class_id int [not null,ref: > Classes.class_id]
  enrollment_date date [default: `now()`]
  grade varchar(2)
  created_at timestamp [default: `now()`]

  indexes {
    (student_id, class_id) [unique]
  }
}